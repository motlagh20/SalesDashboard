# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MariaDB (MySQL) Database Configuration
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="your_password"
DB_NAME="salesdashboard"

# Redis Configuration
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# JWT Authentication Secret Key
# STRICTLY REQUIRED in production: Must be injected via Google Secret Manager into Cloud Run environment variables.
# Startup will fail immediately if missing, shorter than 32 characters (256 bits), or easily guessable.
# To generate a production secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# To deploy to Cloud Run: gcloud run services update salesdashboard --set-secrets=JWT_SECRET=salesdashboard-jwt-secret:latest
JWT_SECRET=""

# Email Settings Encryption Key (AES-256-GCM)
# STRICTLY REQUIRED to encrypt and decrypt SMTP passwords and Webhook API keys.
# Provide a 64-character hex string (32 bytes), a 32-byte base64 key, or a random passphrase >= 32 characters.
# Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_SETTINGS_ENCRYPTION_KEY=""

# Optional dedicated HMAC-SHA256 secret for Email OTP hashing in Redis (falls back to derived key if unset)
OTP_HMAC_SECRET=""
